# Cosmos MCP local environment overrides (optional)
# Copy to `<state_root>/.env` (or repo `.env` for local connection testing only).
# Never commit real `.env` files containing personal URLs, tokens, or paths.

# Optional custom state directory (defaults to %LOCALAPPDATA%\CosmosMCP or ~/.cosmos-mcp)
# COSMOS_MCP_STATE_DIR=

# Optional default workspace directory and permission tier (L1 / L2 / L3 / L4)
# Note: security fields (`COSMOS_PERMISSION_TIER`, `COSMOS_WORKSPACE_ROOTS`) are only honored
# from OS process environment or `<state_root>/.env`, never from untrusted project directories.
# COSMOS_MCP_WORKSPACE=
# COSMOS_PERMISSION_TIER=tier3_workspace_dev

# Optional explicit HTTP/HTTPS/SOCKS5 proxy for outbound tunnel connections
# COSMOS_DEV_PROXY=http://127.0.0.1:7890

# Optional pre-configured public HTTPS gateway base URL for local testing
# COSMOS_PUBLIC_URL=https://your-gateway.example.com
