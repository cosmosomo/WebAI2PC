{
  "manifest_version": "0.4",
  "name": "cosmos-mcp",
  "display_name": "WebAI2PC (Cosmos MCP)",
  "version": "1.2.1",
  "description": "Primarily designed to connect Web Google Gemini (Task Mode & mobile App) and Web ChatGPT (everyday Chat mode + Work mode) to your PC over Streamable HTTP OAuth 2.1, while also providing a parent-bound stdio MCP entry here with 16 core workspace tools, pre-edit snapshots, and recoverable trash.",
  "author": {
    "name": "cosmosomo",
    "url": "https://github.com/cosmosomo/WebAI2PC"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cosmosomo/WebAI2PC"
  },
  "license": "MIT",
  "server": {
    "type": "uv",
    "entry_point": "src/cosmos_mcp/launcher/cli.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "python",
        "-B",
        "-m",
        "cosmos_mcp.launcher.cli",
        "stdio",
        "--workspace",
        "${user_config.workspace}"
      ],
      "env": {
        "PYTHONPATH": "${__dirname}/src",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUTF8": "1",
        "COSMOS_MCP_WORKSPACE": "${user_config.workspace}"
      }
    }
  },
  "user_config": {
    "workspace": {
      "type": "directory",
      "title": "开放工作区文件夹",
      "description": "主面向网页版 Google Gemini 与网页版 ChatGPT（远程 HTTPS 连接请运行启动脚本打开本地控制台）；通过本配置以 stdio 协议启动时开放读写与执行命令的本地项目目录",
      "multiple": false,
      "required": true,
      "default": "${HOME}/CosmosWorkspace"
    }
  },
  "compatibility": {
    "platforms": [
      "win32",
      "darwin",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.10"
    }
  }
}
